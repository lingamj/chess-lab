  function renderDashboardCharts(d) {
    const yearSvg = document.getElementById('chartYears');
    const resultSvg = document.getElementById('chartResults');
    if (!yearSvg || !resultSvg) return;

    yearSvg.style.display = 'block';
    resultSvg.style.display = 'block';
    yearSvg.innerHTML = '';
    resultSvg.innerHTML = '';

    const w = 600;
    const h = 160;
    const pad = 30;

    const years = d.activity.by_year;
    const maxGames = Math.max(...years.map(y => y.games), 1);
    yearSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    let yearHtml = '';
    years.forEach((y, i) => {
      const barW = (w - pad * 2) / years.length;
      const bh = (y.games / maxGames) * (h - pad * 2);
      const x = pad + i * barW;
      const yPos = h - pad - bh;
      yearHtml += `<rect x="${x}" y="${yPos}" width="${Math.max(barW - 2, 1)}" height="${bh}" fill="#3b82f6"><title>${y.year}: ${y.games}</title></rect>`;
    });
    yearSvg.innerHTML = yearHtml;

    const rc = d.results.overall;
    const total = d.overview.total_games;
    resultSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    const resultData = [
      ['White wins', rc.white_wins, '#22c55e'],
      ['Draws', rc.draws, '#eab308'],
      ['Black wins', rc.black_wins, '#ef4444'],
    ];
    const barH = 28;
    let resultHtml = '';
    resultData.forEach((item, i) => {
      const [label, value, color] = item;
      const bw = (value / total) * (w - pad * 2);
      const yPos = pad + i * (barH + 10);
      resultHtml += `<text x="${pad}" y="${yPos - 4}" fill="#d1d5db" font-size="12">${label}</text><rect x="${pad}" y="${yPos}" width="${bw}" height="${barH}" fill="${color}"></rect><text x="${pad + bw + 6}" y="${yPos + barH - 8}" fill="#d1d5db" font-size="12">${value}</text>`;
    });
    resultSvg.innerHTML = resultHtml;
  }


  async function loadDatabaseDashboard() {
    try {
      const res = await fetch('/api/database_games');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      const games = (data.games || []).map(gameFromRow);
      DB.games.length = 0; DB.games.push(...games);
      DB.byId.clear(); games.forEach(g => DB.byId.set(g.id, g));
      window._DB_GAMES = DB.games;
      window._DB_GAME_BY_ID = DB.byId;
      DB.loaded = true;
      window._DB_LOADED = true;
      renderGamesTable(); await loadStatsDashboard(); renderOpenings();
      if (typeof updatePlyAnalysis === 'function') updatePlyAnalysis();
      const sourceEl = document.getElementById('gamesSummary');
      if (sourceEl) sourceEl.dataset.source = 'database';
      if (window._CURRENT_NODE) renderDatabaseNodeDetails(window._CURRENT_NODE);
    } catch (e) {
      console.error('Database dashboard load failed:', e);
      setSummary(`Database dashboard failed: ${e.message}`);
    }
  }
  window.loadDatabaseDashboard = loadDatabaseDashboard;

  // Board.js functions delegate here when database mode is active.
  const oldRebuild = window.rebuildGamesTable;
  window.rebuildGamesTable = function () {
    if (window._DATA_SOURCE === 'database' && DB.loaded) return renderGamesTable();
    return oldRebuild ? oldRebuild() : undefined;
  };
  const oldStats = window.updateStats;
  window.updateStats = function () {
    if (window._DATA_SOURCE === 'database' && DB.loaded) {
      if (DB.dashboard) renderStatsDashboard(DB.dashboard);
      return;
    }
    return oldStats ? oldStats() : undefined;
  };
  const oldInsights = window.updateInsights;
  window.updateInsights = function () {
    if (window._DATA_SOURCE === 'database' && DB.loaded) {
      if (DB.dashboard) renderStatsDashboard(DB.dashboard);
      return;
    }
    return oldInsights ? oldInsights() : undefined;
  };
  const oldOpenings = window.updateOpeningsList;
  window.updateOpeningsList = function () {
    if (window._DATA_SOURCE === 'database' && DB.loaded) return renderOpenings();
    return oldOpenings ? oldOpenings() : undefined;
  };
  const oldNodeDetails = window.renderNodeDetails;
  window.renderNodeDetails = function (node) {
    if (window._DATA_SOURCE === 'database' && DB.loaded) {
      if (!node) {
        const details = document.getElementById('nodeDetails');
        if (details) details.innerHTML = '<div class="small-muted">Position not found in your repertoire tree.</div>';
        const list = document.getElementById('nodeGameList');
        if (list) list.textContent = 'Games in this node will appear here.';
        const buckets = document.getElementById('nodeResultBuckets');
        if (buckets) buckets.innerHTML = '';
        const sample = document.getElementById('sampleGames');
        if (sample) sample.value = '';
        return;
      }
      return renderDatabaseNodeDetails(node);
    }
    return oldNodeDetails ? oldNodeDetails(node) : undefined;
  };

  function wireImportButtons() {
    async function runImport(source) {
      const username = (document.getElementById('import-username')?.value || '').trim();
      const status = document.getElementById('import-status');
      if (!username) { if (status) status.textContent = '⚠️ Please enter a username.'; return; }
      if (status) status.textContent = `⏳ Downloading and importing ${source} games for ${username}…`;
      try {
        const res = await fetch('/api/import_games', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({source, username}) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
        if (status) status.textContent = `✅ ${data.message || 'Import complete.'}`;
        await loadDatabaseDashboard();
        if (typeof initDatabaseRepertoire === 'function') await initDatabaseRepertoire();
      } catch (e) {
        if (status) status.textContent = `❌ ${e.message}`;
      }
    }
    document.getElementById('import-lichess')?.addEventListener('click', () => runImport('lichess'));
    document.getElementById('import-chesscom')?.addEventListener('click', () => runImport('chesscom'));
  }

  const syncInFlight = { lichess: false, chesscom: false };

  const syncJobIds = { lichess: null, chesscom: null };
  const syncPollTimers = { lichess: null, chesscom: null };

  function wireSyncButtons() {
    async function runSync(source) {
      const username = (document.getElementById('import-username')?.value || '').trim();
      const statusEl = document.getElementById(`sync-status-${source}`);
      const btn = document.getElementById(`sync-${source}`);
      const cancelBtn = document.getElementById(`cancel-${source}`);

      if (!username) {
        if (statusEl) statusEl.textContent = '⚠️ Please enter a username.';
        return;
      }

      if (syncInFlight[source]) return;
      syncInFlight[source] = true;
      if (btn) btn.disabled = true;
      if (cancelBtn) cancelBtn.disabled = false;
      if (statusEl) statusEl.textContent = `⏳ Starting ${source} sync for ${username}…`;

      try {
        const startRes = await fetch('/api/sync/start', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({source, username})
        });
        const startData = await startRes.json();

        if (startRes.status === 409 && startData.job_id) {
          syncJobIds[source] = startData.job_id;
          if (statusEl) statusEl.textContent = `⚠️ ${source}: already running as job ${startData.job_id}.`;
        } else if (!startRes.ok) {
          throw new Error(startData.error || `HTTP ${startRes.status}`);
        } else {
          syncJobIds[source] = startData.job_id;
          if (statusEl) statusEl.textContent = `⏳ ${source} job ${startData.job_id} started…`;
        }

        await pollSyncJob(source, syncJobIds[source], statusEl);
      } catch (e) {
        if (statusEl) statusEl.textContent = `❌ ${e.message}`;
      } finally {
        syncInFlight[source] = false;
        if (btn) btn.disabled = false;
        if (cancelBtn) cancelBtn.disabled = true;
        await refreshSyncState();
        await loadDatabaseDashboard();
        if (typeof initDatabaseRepertoire === 'function') await initDatabaseRepertoire();
      }
    }

    async function pollSyncJob(source, jobId, statusEl) {
      clearInterval(syncPollTimers[source]);

      return new Promise((resolve) => {
        syncPollTimers[source] = setInterval(async () => {
          try {
            const res = await fetch(`/api/sync/status?job_id=${encodeURIComponent(jobId)}`);
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);

            const job = data.job || {};
            const phase = job.phase || 'working';
            if (statusEl) {
              statusEl.textContent =
                `${source}: ${job.status} • ${phase} • ` +
                `dl ${job.downloaded_count || 0} • ` +
                `parsed ${job.parsed_count || 0} • ` +
                `new ${job.imported_count || 0} • ` +
                `dup ${job.duplicate_count || 0}`;
            }

            if (['completed', 'failed', 'canceled', 'interrupted'].includes(job.status)) {
              clearInterval(syncPollTimers[source]);
              if (statusEl) {
                if (job.status === 'completed') {
                  statusEl.textContent =
                    `✅ ${source}: ${job.imported_count || 0} new, ` +
                    `${job.duplicate_count || 0} duplicates, ` +
                    `tree ${job.tree_rebuilt ? 'rebuilt' : 'unchanged'}`;
                } else {
                  statusEl.textContent =
                    `❌ ${source} ${job.status}: ${job.error || job.last_error || ''}`;
                }
              }
              resolve();
            }
          } catch (e) {
            clearInterval(syncPollTimers[source]);
            if (statusEl) statusEl.textContent = `❌ Sync status error: ${e.message}`;
            resolve();
          }
        }, 2000);
      });
    }

    async function cancelSync(source) {
      const jobId = syncJobIds[source];
      const statusEl = document.getElementById(`sync-status-${source}`);
      const cancelBtn = document.getElementById(`cancel-${source}`);

      if (!jobId) {
        if (statusEl) statusEl.textContent = `⚠️ No active ${source} job.`;
        return;
      }

      if (cancelBtn) cancelBtn.disabled = true;

      try {
        const res = await fetch('/api/sync/cancel', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({job_id: jobId})
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
        if (statusEl) statusEl.textContent = `⏹ ${source}: cancel requested.`;
      } catch (e) {
        if (statusEl) statusEl.textContent = `❌ Cancel failed: ${e.message}`;
        if (cancelBtn) cancelBtn.disabled = false;
      }
    }

    document.getElementById('sync-lichess')?.addEventListener('click', () => runSync('lichess'));
    document.getElementById('sync-chesscom')?.addEventListener('click', () => runSync('chesscom'));
    document.getElementById('cancel-lichess')?.addEventListener('click', () => cancelSync('lichess'));
    document.getElementById('cancel-chesscom')?.addEventListener('click', () => cancelSync('chesscom'));
  }

  let syncStateRefreshTimer = null;

  async function refreshSyncState() {
    const username = (document.getElementById('import-username')?.value || '').trim();

    if (!username) {
      for (const source of ['lichess', 'chesscom']) {
        const stateEl = document.getElementById(`sync-state-${source}`);
        if (stateEl) stateEl.textContent = `${source}: Last sync Never • Imported today — • Tree clean`;
      }
      return;
    }

    for (const source of ['lichess', 'chesscom']) {
      const stateEl = document.getElementById(`sync-state-${source}`);
      if (!stateEl) continue;

      try {
        const res = await fetch(`/api/sync_state?source=${source}&username=${encodeURIComponent(username)}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);

        const st = data.state || {};
        const last = st.last_successful_sync_at
          ? new Date(st.last_successful_sync_at).toLocaleString()
          : 'Never';
        const tree = st.tree_dirty ? 'dirty' : 'clean';
        const importedToday = data.today_imported || 0;

        stateEl.textContent = `${source}: Last sync ${last} • Imported today ${importedToday} • Tree ${tree}`;
      } catch (e) {
        stateEl.textContent = `${source}: sync state unavailable`;
      }
    }
  }

  function wireCopyOpening() {
    document.getElementById('copyOpeningLineBtn')?.addEventListener('click', () => {
      const text = window._SELECTED_OPENING_LINE || '';
      if (!text) return;
      const formatted = text.split(' ').map((m,i)=>(i%2===0?`${Math.floor(i/2)+1}. `:'')+m).join(' ');
      navigator.clipboard?.writeText(formatted).then(() => {
        const btn = document.getElementById('copyOpeningLineBtn');
        if (btn) { const old=btn.textContent; btn.textContent='Copied ✓'; setTimeout(()=>btn.textContent=old,900); }
      }).catch(() => prompt('Opening line:', formatted));
    });
  }

  function wireDatabaseNavigationGuards() {
    // DB navigation synchronization is now handled by board.js updateBoardFromLine().
  }

  document.addEventListener('DOMContentLoaded', () => {
    wireImportButtons();
    wireSyncButtons();
    wireCopyOpening();
    wireDatabaseNavigationGuards();

    const usernameInput = document.getElementById('import-username');
    if (usernameInput) {
      usernameInput.addEventListener('input', () => {
        clearTimeout(syncStateRefreshTimer);
        syncStateRefreshTimer = setTimeout(refreshSyncState, 400);
      });
    }

    refreshSyncState();

    // Give board.js a moment to initialize its tree, then fill all database panels.
    setTimeout(loadDatabaseDashboard, 0);
  });
})();
