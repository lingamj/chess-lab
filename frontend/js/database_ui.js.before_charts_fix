        <table class="ply-analysis-table">
          <thead><tr><th>Length</th><th>Games</th><th>White wins</th><th>Draws</th><th>Black wins</th><th>White score</th></tr></thead>
          <tbody>${dist.map(x => `<tr><td>${x.bucket}</td><td>${x.games}</td><td>${x.white_wins}</td><td>${x.draws}</td><td>${x.black_wins}</td><td>${scorePct(x.white_wins, x.draws, x.games)}%</td></tr>`).join('')}</tbody>
        </table>`;
    }

    const firstMovesEl = document.getElementById('statsFirstMoves');
    if (firstMovesEl) {
      const items = d.first_moves.items.slice(0, 10);
      firstMovesEl.innerHTML = `
        <strong>First moves</strong><br>
        <em>Minimum games shown: ${d.first_moves.minimum_games}</em><br><br>
        <table class="ply-analysis-table">
