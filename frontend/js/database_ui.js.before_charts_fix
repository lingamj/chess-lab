        <strong>Last 12 months</strong><br>${latestMonths.map(m => `${m.month}: ${m.games}`).join(' • ')}<br><br>
        <strong>Seasonality by month</strong><br>${season.map(m => `${m.month}: ${m.games}`).join(' • ')}<br><br>
        <strong>By weekday</strong><br>${week.map(w => `${w.weekday}: ${w.games}`).join(' • ')}`;
