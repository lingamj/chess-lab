          <div><strong>${ov.games_with_actual_moves}</strong><br><span class="small-muted">Games with moves</span></div>
          <div><strong>${ov.zero_move_games}</strong><br><span class="small-muted">Zero-move games</span></div>
          <div><strong>${ov.decisive_games}</strong><br><span class="small-muted">Decisive games</span></div>
          <div><strong>${ov.draws}</strong><br><span class="small-muted">Draws</span></div>
